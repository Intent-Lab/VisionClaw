// Copy this file to Secrets.kt and fill in your values.
// Secrets.kt is gitignored and will not be committed.

package com.meta.wearable.dat.externalsampleapps.cameraaccess

object Secrets {
    // REQUIRED: Get your key at https://aistudio.google.com/apikey
    const val geminiAPIKey = "YOUR_GEMINI_API_KEY"

    // REQUIRED: Jarvis Memory API (this fork replaced OpenClaw with a typed
    // HTTP client to your own personal memory server).
    //
    // jarvisApiBase:
    //   - Phone on same Wi-Fi as Mac running the server: http://Your-Mac.local:8000
    //     (find Bonjour name with: scutil --get LocalHostName)
    //   - Tailscale / public: http://100.x.y.z:8000 or https://your-domain
    //
    // jarvisApiKey: must match API_KEY in jarvis_project/.env
    const val jarvisApiBase = "http://YOUR_HOST:8000"
    const val jarvisApiKey = "YOUR_JARVIS_API_KEY"

    // OPTIONAL — legacy OpenClaw fields, no longer used by this fork.
    // Kept for compatibility with original VisionClaw code paths and the
    // Settings UI. Safe to leave as defaults.
    const val openClawHost = "http://YOUR_MAC_HOSTNAME.local"
    const val openClawPort = 18789
    const val openClawHookToken = "YOUR_OPENCLAW_HOOK_TOKEN"
    const val openClawGatewayToken = "YOUR_OPENCLAW_GATEWAY_TOKEN"

    // OPTIONAL: WebRTC signaling server URL (for live POV streaming)
    const val webrtcSignalingURL = "wss://YOUR_SIGNALING_SERVER"
}
