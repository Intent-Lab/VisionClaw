POSTGRES_PASSWORD=replace-with-random-password
# Postgres connection (matches docker-compose, port 5433 to avoid clash with system pg)
DATABASE_URL=postgresql://jarvis:replace-with-random-password@localhost:5433/jarvis

# API key — clients must send this in X-API-Key header. Rotate before production.
API_KEY=replace-with-random-api-key

HOST=0.0.0.0
PORT=8000

# Embedding model — both are 1024-dim, drop-in swappable.
#   nlpai-lab/KURE-v1   → Korean-focused (BGE-M3 한국어 파인튜닝)
#   BAAI/bge-m3         → multilingual baseline
EMBEDDING_MODEL=nlpai-lab/KURE-v1
EMBEDDING_DIM=1024
FACE_EMBEDDING_DIM=512

# cpu | cuda | mps
EMBEDDING_DEVICE=cpu

# OpenAI meeting transcription/summarization (server-side only)
OPENAI_API_KEY=
# GPT_API_KEY is also accepted as a backward-compatible alias.
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_SUMMARY_MODEL=gpt-4.1-mini
OPENAI_REASONING_EFFORT=low

# Jarvis Agent / MCP orchestration
JARVIS_ROUTER_MODEL=gpt-4.1-mini
JARVIS_PLANNER_MODEL=gpt-4.1-mini
JARVIS_ANSWER_MODEL=gpt-4.1-mini

# OAuth integrations. Fill these when enabling each provider.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=
SLACK_DEFAULT_CHANNEL_ID=

NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=
