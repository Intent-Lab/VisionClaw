package com.meta.wearable.dat.externalsampleapps.cameraaccess

object Secrets {
    // Hosted gateway that mints LiveKit room tickets. Point this at your own
    // deployment -- see gateway/README.md. Leave the token empty: it is
    // per-person identity, entered in the app on first launch (baking one in
    // would make every install the same user).
    const val gatewayBaseUrl = "https://api.visionagents.app"
    const val gatewayToken = ""
}
